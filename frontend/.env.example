# Leave blank to use the same-origin /api proxy in Vite development.
# Set to a backend origin only for an explicitly credentialed cross-origin deployment.
VITE_API_BASE_URL=
# Use the real backend. Set true only for isolated UI development.
VITE_USE_MOCK=false
# Distinct browser hosts keep the host-only staff session cookie out of customer tabs.
VITE_CUSTOMER_ORIGIN=http://127.0.0.1:5173
VITE_ADMIN_ORIGIN=http://localhost:5173
