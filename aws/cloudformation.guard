let security_groups = Resources.*[ Type == "AWS::EC2::SecurityGroup" ]
let distributions = Resources.*[ Type == "AWS::CloudFront::Distribution" ]

rule SECURITY_GROUP_INGRESS_IS_SCOPED when %security_groups !empty {
    %security_groups.Properties.SecurityGroupIngress[*] {
        CidrIp NOT EXISTS
        SourcePrefixListId == "pl-3b927c52"
    }
}

rule CLOUDFRONT_REQUIRES_HTTPS_AND_NO_CACHE when %distributions !empty {
    %distributions.Properties.DistributionConfig.DefaultCacheBehavior {
        ViewerProtocolPolicy == "redirect-to-https"
        CachePolicyId == "4135ea2d-6df8-44a3-9df3-4b5a84be39ad"
    }
}

rule EC2_ROOT_VOLUME_ENCRYPTED {
    Resources.*[ Type == "AWS::EC2::Instance" ].Properties.BlockDeviceMappings[*].Ebs {
        Encrypted == true
    }
}
