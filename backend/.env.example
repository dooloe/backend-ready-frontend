# Export these before starting the server; this template is not auto-loaded.
# Relative SQLite paths resolve from the server's working directory.
DATABASE_URL=sqlite:///backend/data/kezek.db
APP_ENV=development
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Force Secure on session cookies behind an HTTPS-terminating proxy. If unset,
# the backend uses Secure when the incoming request URL is HTTPS.
# SESSION_COOKIE_SECURE=true
# Optional Web Push configuration. Leave unset to use the ticket-page polling fallback.
# Generate VAPID keys outside the repository; the private key setting may be a protected file path.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=mailto:ops@example.org
